# Example environment variables (copy to .env.local for local dev)
# Do NOT commit .env.local

# Public site URL (used for canonical, sitemap, robots)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Prisma / Database (Supabase Postgres)
# DATABASE_URL: use the pooled/transaction URL if Supabase provides it (good for serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# DIRECT_URL: direct connection (non-pooled) recommended for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Admin login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Session signing secret (make this long & random)
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
