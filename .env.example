# Example environment variables (copy to .env.local for local dev)
# Do NOT commit .env.local

# Public site URL (used for canonical, sitemap, robots)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Session signing secret (make this long & random)
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
